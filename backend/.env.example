# Application Settings
PROJECT_NAME="Cineforge API"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
# Supports JSON array or comma-separated list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Telegram MTProto User Session Configuration
# Obtain API_ID and API_HASH from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=cineforge_session

# Third-Party Movie Search Bot Username (e.g. @YourMovieBot or YourMovieBot)
# The authenticated user session communicates directly with this bot in private chat
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_RESPONSE_TIMEOUT=15

# Media Streaming & Performance Settings
# MTProto standard max chunk size: 524288 (512 KB)
TELEGRAM_CHUNK_SIZE=524288
MEDIA_PREFETCH_CHUNKS=4
MAX_MEDIA_BUFFER_SIZE=8388608

# Milestone B6: Session & Adaptive Bounded Cache Configuration
MEDIA_MAX_BUFFER_MB=16
MEDIA_SESSION_TIMEOUT=600
MEDIA_PREFETCH_CHUNKS_AHEAD=2
