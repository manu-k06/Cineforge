# Application Settings
PROJECT_NAME="Cineforge API"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
# Supports JSON array or comma-separated list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Telegram MTProto User Session Configuration
# Obtain API_ID and API_HASH from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=cineforge_session
# For Cloud Deployments (Render / Railway / Heroku):
# Generate using: python export_session.py
# TELEGRAM_STRING_SESSION=

# Phase 1: CineAI Intelligence & Query Refinement Engine
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SEARCH_ENABLED=True

# Third-Party Movie Search Bot Username (e.g. @YourMovieBot or YourMovieBot)
# The authenticated user session communicates directly with this bot in private chat
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_RESPONSE_TIMEOUT=15

# Media Streaming & Performance Settings
# MTProto standard max chunk size: 524288 (512 KB)
TELEGRAM_CHUNK_SIZE=524288
MEDIA_PREFETCH_CHUNKS=4
MAX_MEDIA_BUFFER_SIZE=8388608

# Milestone B6: Session & Adaptive Bounded Cache Configuration
MEDIA_MAX_BUFFER_MB=16
MEDIA_SESSION_TIMEOUT=600
MEDIA_PREFETCH_CHUNKS_AHEAD=2

# Milestone B7: Media Probing, Compatibility & Playback Sustainability
FFPROBE_PATH=ffprobe
MEDIA_SUSTAINABILITY_MARGIN=1.15
MEASURED_SOURCE_THROUGHPUT_BPS=1050000
PROBE_INITIAL_BYTES=2097152

# Phase 11: Go Streamer Integration (Local or Render Cloud)
# Local: http://127.0.0.1:8088 | Render: https://cineforge-streamer.onrender.com
STREAMER_BASE_URL=http://127.0.0.1:8088
STREAM_SECRET_KEY=
STREAM_URL_EXPIRATION_SECONDS=21600
STREAMER_TIMEOUT_SECONDS=3.0

